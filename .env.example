
# Spring Boot Datasource (JDBC Connection)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Database Detailed Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viettoria_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=prefer

# Server Configuration
SERVER_PORT=8081

# Tự gọi GET /api/health/ping để giữ backend và database hoạt động
SELF_KEEPALIVE_ENABLED=true
SELF_KEEPALIVE_INTERVAL_MS=300000
SELF_KEEPALIVE_INITIAL_DELAY_MS=300000
# Có thể ghi đè URL nếu chạy sau reverse proxy/container đặc biệt
# SELF_KEEPALIVE_URL=https://your-api-domain.example/api/health/ping

# Security & Authentication (JJWT HMAC-SHA256)
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRATION_MS=86400000

# Tài khoản quản trị được tạo khi database chưa có admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-unique-password

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000
DEMO_LOGIN_ENABLED=true

# Cloudinary credentials (API Secret chỉ lưu ở backend/Render)
CLOUDINARY_CLOUD_NAME=<cloud_name>
CLOUDINARY_API_KEY=<api_key>
CLOUDINARY_API_SECRET=<api_secret>

# Thư mục lưu file trên backend khi Cloudinary chưa khả dụng
APP_UPLOAD_DIR=uploads
MAX_UPLOAD_FILE_SIZE=100MB
MAX_UPLOAD_REQUEST_SIZE=105MB
