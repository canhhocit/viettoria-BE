
# Database Connection URI (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://<username>:<password>@<host>:<port>/<database>?sslmode=require

# Spring Boot Datasource (JDBC Connection)
SPRING_DATASOURCE_URL=jdbc:postgresql://<host>:<port>/<database>?sslmode=require
SPRING_DATASOURCE_USERNAME=<username>
SPRING_DATASOURCE_PASSWORD=<password>
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver

# Database Detailed Credentials
DB_HOST=localhost
DB_PORT=5432
DB_NAME=viettoria_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSLMODE=prefer

# Server Configuration
SERVER_PORT=5000

# Security & Authentication (JJWT HMAC-SHA256)
JWT_SECRET=your-secure-jwt-secret-key-at-least-256-bits-long
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
